---
// SE involvement by stage (Presales Collective table on this page) + the three POC phases.
const stages = [
  { n: 'Research', job: 'Deep-dive on customer systems; whiteboard pains/use cases with the AE before contact.',
    lists: [{ t: 'Discovery call checklist', a: '#discovery-call-checklist', why: 'prepares for' }] },
  { n: 'Discovery', job: 'As-Is architecture.',
    lists: [{ t: 'Discovery call checklist', a: '#discovery-call-checklist', why: 'runs' }] },
  { n: 'Outcomes definition', job: 'Lead "Art of the Possible" workshops; define To-Be and success metrics.',
    lists: [{ t: 'Discovery call checklist', a: '#discovery-call-checklist', why: 'future-state item in' }, { t: 'POC / pilot checklist', a: '#poc--pilot-checklist', why: 'success criteria feed' }] },
  { n: 'Evaluation', job: 'Scoped demos / POCs.',
    lists: [{ t: 'Demo checklist', a: '#demo-checklist', why: 'runs' }, { t: 'POC / pilot checklist', a: '#poc--pilot-checklist', why: 'runs' }] }
];
const phases = [
  { n: 'Planning', d: 'Scope, criteria, data, ground truth, resources, timeline.' },
  { n: 'Execution', d: 'Setup, configuration, test runs, measurement, user feedback, issue log.' },
  { n: 'Evaluation', d: 'Quantitative/qualitative analysis, gap/risk review, recommendation.' }
];
// Ring geometry: three 120° arcs around the exit decision.
const cx = 130, cy = 130, r = 92, gap = 6;
const pt = (deg: number, rad = r) => [cx + rad * Math.cos((deg - 90) * Math.PI / 180), cy + rad * Math.sin((deg - 90) * Math.PI / 180)];
const arcs = phases.map((p, i) => {
  const a0 = i * 120 + gap, a1 = (i + 1) * 120 - gap;
  const [x0, y0] = pt(a0), [x1, y1] = pt(a1), [lx, ly] = pt(i * 120 + 60, r + 0);
  return { ...p, d: p.d, path: `M${x0.toFixed(1)},${y0.toFixed(1)} A${r},${r} 0 0 1 ${x1.toFixed(1)},${y1.toFixed(1)}`, lx, ly, i };
});
---
<section class="viz serun" aria-labelledby="serun-title" data-serun data-stages={JSON.stringify(stages)} data-phases={JSON.stringify(phases)}>
  <div class="viz-head">
    <h2 id="serun-title">Where the SE earns their keep</h2>
    <p class="viz-hint">Tap a stage or a POC phase.</p>
  </div>
  <div class="viz-stage serun-grid">
    <div class="serun-track">
      <div class="serun-band" aria-hidden="true"><span>Value Creator · early</span><span>Value Fulfiller · late</span></div>
      <ol>
        {stages.map((s, i) => (
          <li>
            <button type="button" class="serun-stop" data-i={i} aria-label={`${s.n}: SE job`}>
              <span class="serun-dot" aria-hidden="true"></span>
              <span class="v-mono-h">{String(i + 1).padStart(2, '0')}</span>
              <b>{s.n}</b>
              <span class="serun-job">{s.job}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
    <figure class="serun-ring">
      <svg viewBox="0 0 260 260" role="group" aria-label="POC phases">
        <defs>
          <marker id="serun-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L8,4 L0,8 z" style="fill:var(--ink)" /></marker>
        </defs>
        {arcs.map((a) => (
          <g class="v-hit serun-phase" tabindex="0" role="button" aria-label={`POC phase ${a.i + 1}: ${a.n}`} data-p={a.i}>
            <path d={a.path} class="serun-arc-hit" />
            <path d={a.path} class="serun-arc" marker-end="url(#serun-arrow)" />
            <text x={a.lx} y={a.ly - 8} text-anchor="middle" class="serun-plabel">{a.n}</text>
          </g>
        ))}
        <circle cx={cx} cy={cy} r="46" class="v-node" />
        <text x={cx} y={cy - 6} text-anchor="middle" class="v-mono">Exit</text>
        <text x={cx} y={cy + 10} text-anchor="middle" class="v-mono">decision</text>
      </svg>
      <figcaption class="v-mono-h">POC phases → Proceed / Conditional / Extend / Fail</figcaption>
    </figure>
  </div>
  <div class="viz-readout" aria-live="polite" data-readout>
    <p>The SE's highest leverage is <b>before</b> the demo: research, As-Is discovery and To-Be metrics. Tap a stage to see the job and the checklist on this page that goes with it.</p>
  </div>
</section>

<style>
  .serun-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 0; }
  .serun-track { padding: 18px 18px 8px; border-right: 1px solid var(--rule); min-width: 0; }
  .serun-band { display: flex; justify-content: space-between; padding: 6px 10px; margin-bottom: 18px; font: 500 10.5px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2);
    background: linear-gradient(90deg, var(--accent-soft), var(--paper-3)); }
  .serun-track ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); position: relative; }
  .serun-track ol::before { content: ""; position: absolute; left: 0; right: 0; top: 8px; height: 2px; background: var(--ink); }
  .serun-track li { margin: 0; min-width: 0; }
  .serun-stop { position: relative; display: flex; flex-direction: column; gap: 6px; width: 100%; min-height: 44px; padding: 26px 12px 14px 0; background: none; border: 0; text-align: left; cursor: pointer; color: var(--ink); }
  .serun-dot { position: absolute; top: 2px; left: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--paper-2); border: 2px solid var(--ink); transition: background var(--dur) var(--ease); }
  .serun-stop:hover .serun-dot, .serun-stop.is-hot .serun-dot { background: var(--accent); border-color: var(--accent); }
  .serun-stop b { font: 600 15px/1.25 var(--display); }
  .serun-stop.is-hot b, .serun-stop:hover b { color: var(--accent); }
  .serun-job { font-size: 13px; line-height: 1.4; color: var(--ink-2); }
  .v-mono-h { font: 500 10.5px var(--mono); color: var(--ink-2); letter-spacing: .06em; text-transform: uppercase; }
  .serun-ring { margin: 0; padding: 12px; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .serun-ring svg { max-width: 240px; }
  .serun-ring figcaption { text-align: center; }
  .serun-arc { fill: none; stroke: var(--ink); stroke-width: 3; }
  .serun-arc-hit { fill: none; stroke: transparent; stroke-width: 30; }
  .serun-plabel { fill: var(--ink); font: 600 12px var(--sans); paint-order: stroke; stroke: var(--paper-2); stroke-width: 5px; }
  .serun-phase:hover .serun-arc, .serun-phase.is-hot .serun-arc { stroke: var(--accent); stroke-width: 5; }
  .serun-phase:hover .serun-plabel, .serun-phase.is-hot .serun-plabel { fill: var(--accent); }
  .serun-phase:focus-visible { outline: none; }
  .serun-phase:focus-visible .serun-arc { stroke: var(--accent); }
  @media (max-width: 759px) {
    .serun-grid { grid-template-columns: 1fr; }
    .serun-track { border-right: 0; border-bottom: 1px solid var(--rule); }
    .serun-track ol { grid-template-columns: 1fr; }
    .serun-track ol::before { left: 6px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .serun-stop { padding: 8px 0 14px 28px; }
    .serun-dot { top: 10px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-serun]').forEach((root) => {
    type L = { t: string; a: string; why: string };
    const stages: { n: string; job: string; lists: L[] }[] = JSON.parse(root.dataset.stages!);
    const phases: { n: string; d: string }[] = JSON.parse(root.dataset.phases!);
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const stops = Array.from(root.querySelectorAll<HTMLElement>('.serun-stop'));
    const arcs = Array.from(root.querySelectorAll<SVGGElement>('.serun-phase'));
    const hot = (el: Element) => [...stops, ...arcs].forEach((x) => x.classList.toggle('is-hot', x === el));

    stops.forEach((b) => b.addEventListener('click', () => {
      const s = stages[Number(b.dataset.i)];
      hot(b);
      readout.innerHTML = `<h3>${s.n}</h3><p><b>SE job:</b> ${s.job}</p>
        <p>${s.lists.map((l) => `<span class="muted">${l.why}</span> <a href="${l.a}">${l.t} →</a>`).join(' · ')}
        <span class="tag">inference</span></p>`;
    }));
    const pick = (g: SVGGElement) => {
      const i = Number(g.dataset.p);
      hot(g);
      readout.innerHTML = `<h3>POC phase ${i + 1} · ${phases[i].n}</h3><p>${phases[i].d}</p>
        <p class="small muted">${i === 2 ? 'Exit decision: Proceed / Conditional / Extend / Fail — judged on technical viability, business value and organisational readiness.' : `Next: ${phases[i + 1].n}.`} <a href="#poc--pilot-checklist">POC checklist →</a></p>`;
    };
    arcs.forEach((g) => {
      g.addEventListener('click', () => pick(g));
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(g); } });
    });
  });
</script>
