---
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Daily selling reference cards and weekly oil & gas digital news for a Technical Sales Manager in Kuwait.' } = Astro.props;
const fullTitle = title === 'Sales Hub' ? title : `${title} · Sales Hub`;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c2127" />
    <meta name="color-scheme" content="dark light" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <meta name="apple-mobile-web-app-title" content="Hub" />
    <link rel="alternate" type="application/rss+xml" title="Sales Hub — O&G digital news" href="/rss.xml" />
    <script is:inline>
      // Dark is the default; a stored "light" choice overrides it. Storage can throw in private mode.
      (function () {
        var t = 'dark';
        try { t = localStorage.getItem('theme') || 'dark'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#f6f7f9' : '#1c2127');
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <Nav />
      <main class="page" id="main">
        <slot />
      </main>
      <footer class="footer">
        <span>Sales Hub · reference notes dated 2026-10-28 · benchmarks tagged <span class="tag warning">indicative</span> are vendor/aggregator figures, not O&G-specific</span>
        <span><a href="/rss.xml">RSS</a> · <a href="/sources/">Sources</a> · <a href="/styleguide/">Styleguide</a></span>
      </footer>
    </div>
    <script>
      import '../scripts/enhance.ts';
    </script>
  </body>
</html>
